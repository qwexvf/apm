---
import { ThemeToggle } from "./ThemeToggle";
import { MobileSidebar } from "./MobileSidebar";
import { Search } from "./Search";
import type { NavGroup } from "@/lib/nav";

interface Props {
  groups: NavGroup[];
  currentSlug: string;
}

const { groups, currentSlug } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";
---

<header class="sticky top-0 z-40 h-13 border-b border-[var(--color-rule)] bg-[var(--color-bg)]/90 backdrop-blur-md">
  <div class="mx-auto flex h-full max-w-[82rem] items-center gap-6 px-5">

    <!-- Logo -->
    <a href={base} class="group flex items-center gap-2.5 shrink-0">
      <!-- Amber bracket logo -->
      <div class="flex items-center justify-center w-7 h-7 border border-[var(--color-signal)]/40 bg-[var(--color-signal-bg)] rounded-sm group-hover:border-[var(--color-signal)]/80 transition-colors">
        <svg viewBox="0 0 18 18" fill="none" class="w-4 h-4">
          <path d="M5 4L2 9l3 5" stroke="var(--color-signal)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M13 4l3 5-3 5" stroke="var(--color-signal)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="9" cy="9" r="1.2" fill="var(--color-signal)" opacity="0.6"/>
        </svg>
      </div>
      <div class="flex items-baseline gap-1.5">
        <span class="font-display font-800 text-[15px] tracking-tight text-[var(--color-fg-strong)]">apm</span>
        <span class="font-mono text-[10px] text-[var(--color-fg-faint)] border border-[var(--color-rule-strong)] rounded-sm px-1 py-px leading-none">v0.1</span>
      </div>
    </a>

    <!-- Divider -->
    <div class="h-4 w-px bg-[var(--color-rule-strong)] hidden sm:block"></div>

    <!-- Nav links -->
    <nav class="hidden items-center gap-5 md:flex">
      <a
        href={base + "installation/"}
        class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-fg-mute)] hover:text-[var(--color-fg-strong)] transition-colors"
      >
        Docs
      </a>
      <a
        href="https://github.com/qwexvf/apm"
        class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-fg-mute)] hover:text-[var(--color-fg-strong)] transition-colors flex items-center gap-1"
        target="_blank"
        rel="noopener"
      >
        GitHub
        <svg viewBox="0 0 12 12" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.5" class="opacity-60">
          <path d="M2 2h8M10 2v8M2 10l8-8"/>
        </svg>
      </a>
    </nav>

    <!-- Right side -->
    <div class="ml-auto flex items-center gap-1.5">
      <Search client:load baseHref={base} />
      <ThemeToggle client:load />
      <MobileSidebar client:load groups={groups} currentSlug={currentSlug} baseHref={base} />
    </div>
  </div>
</header>
