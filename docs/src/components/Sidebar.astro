---
import type { NavGroup } from "@/lib/nav";

interface Props {
  groups: NavGroup[];
  currentSlug: string;
}

const { groups, currentSlug } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";
---

<aside class="hidden md:flex flex-col sticky top-13 h-[calc(100vh-3.25rem)] w-56 shrink-0 overflow-y-auto border-r border-[var(--color-rule)] py-7 pr-3">
  <nav class="flex-1">
    {groups.map((group) => (
      <div class="mb-7">
        <!-- Section label -->
        <div class="mb-2 px-3 flex items-center gap-2">
          <span class="font-mono text-[0.65rem] font-700 uppercase tracking-[0.18em] text-[var(--color-fg-faint)]">
            {group.label}
          </span>
          <div class="flex-1 h-px bg-[var(--color-rule)]"></div>
        </div>

        <ul class="space-y-px">
          {group.items.map((item) => {
            const isCurrent = item.slug === currentSlug;
            const href = base + item.href.replace(/^\//, "");
            return (
              <li>
                <a
                  href={href}
                  class:list={[
                    "group flex items-center gap-2 px-3 py-1.5 text-[13px] transition-all duration-150 rounded-sm border-l-2",
                    isCurrent
                      ? "border-[var(--color-signal)] bg-[var(--color-signal-bg)] text-[var(--color-signal)] font-600"
                      : "border-transparent text-[var(--color-fg-mute)] hover:text-[var(--color-fg)] hover:border-[var(--color-rule-strong)] hover:bg-[var(--color-bg-elev)]",
                  ]}
                >
                  {isCurrent && (
                    <span class="w-1 h-1 rounded-full bg-[var(--color-signal)] shrink-0 animate-pulse"></span>
                  )}
                  <span class="font-mono">{item.label}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </nav>

  <!-- Bottom tagline -->
  <div class="mt-4 px-3 pt-4 border-t border-[var(--color-rule)]">
    <p class="font-mono text-[10px] text-[var(--color-fg-faint)] leading-relaxed">
      <span class="text-[var(--color-signal)]">$</span> apm —<br/>
      plugin manager<br/>
      for agents
    </p>
  </div>
</aside>
