---
import BaseLayout from "./BaseLayout.astro";
import Sidebar from "@/components/Sidebar.astro";
import { buildNav, findAdjacent } from "@/lib/nav";

interface Props {
  title: string;
  description?: string;
  currentSlug: string;
  toc?: { depth: number; slug: string; text: string }[];
}

const { title, description, currentSlug, toc = [] } = Astro.props;
const groups = await buildNav();
const { prev, next } = await findAdjacent(currentSlug);
const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";
const editBase = "https://github.com/qwexvf/apm/edit/main/docs/src/content/docs/";
---

<BaseLayout title={`${title} — apm`} description={description} currentSlug={currentSlug}>
  <div class="mx-auto max-w-[82rem] px-5">
    <div class="flex gap-8">
      <Sidebar groups={groups} currentSlug={currentSlug} />

      <main class="min-w-0 flex-1 py-10">
        <article class="prose-docs max-w-none">
          <!-- Page header -->
          <header class="mb-10">
            <div class="mb-3 font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-fg-faint)]">
              apm / {currentSlug.replace(/\//g, " / ")}
            </div>
            <h1 class="font-display text-[2rem] font-800 leading-tight tracking-tight text-[var(--color-fg-strong)] md:text-[2.5rem]">
              {title}
            </h1>
            {description && (
              <p class="mt-3 text-[15px] text-[var(--color-fg-mute)] leading-relaxed max-w-[60ch]">{description}</p>
            )}
            <!-- Amber accent line -->
            <div class="mt-5 flex items-center gap-3">
              <div class="h-px w-8 bg-[var(--color-signal)]"></div>
              <div class="h-px w-4 bg-[var(--color-signal)]/40"></div>
              <div class="h-px w-2 bg-[var(--color-signal)]/20"></div>
            </div>
          </header>

          <slot />
        </article>

        <!-- Edit link -->
        <div class="mt-12 flex items-center justify-between border-t border-[var(--color-rule)] pt-5">
          <a
            href={editBase + currentSlug + ".md"}
            class="font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-fg-faint)] hover:text-[var(--color-signal)] transition-colors"
          >
            Edit on GitHub ↗
          </a>
        </div>

        <!-- Prev / Next -->
        {(prev || next) && (
          <nav class="mt-5 grid grid-cols-1 gap-3 md:grid-cols-2">
            {prev ? (
              <a
                href={base + prev.href.replace(/^\//, "")}
                class="group block rounded-sm border border-[var(--color-rule)] bg-[var(--color-bg-elev)] p-4 transition-all hover:border-[var(--color-signal)]/50 hover:bg-[var(--color-signal-bg)]"
              >
                <span class="block font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--color-fg-faint)] mb-1">
                  ← prev
                </span>
                <span class="font-display font-700 text-[var(--color-fg-strong)] group-hover:text-[var(--color-signal)] transition-colors">
                  {prev.label}
                </span>
              </a>
            ) : <span />}
            {next ? (
              <a
                href={base + next.href.replace(/^\//, "")}
                class="group block rounded-sm border border-[var(--color-rule)] bg-[var(--color-bg-elev)] p-4 text-right transition-all hover:border-[var(--color-signal)]/50 hover:bg-[var(--color-signal-bg)]"
              >
                <span class="block font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--color-fg-faint)] mb-1">
                  next →
                </span>
                <span class="font-display font-700 text-[var(--color-fg-strong)] group-hover:text-[var(--color-signal)] transition-colors">
                  {next.label}
                </span>
              </a>
            ) : <span />}
          </nav>
        )}
      </main>

      <!-- Table of Contents -->
      {toc.length > 0 && (
        <aside class="hidden w-44 shrink-0 lg:block">
          <div class="sticky top-24 py-10">
            <div class="mb-3 font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-fg-faint)]">
              On this page
            </div>
            <ul class="space-y-px border-l border-[var(--color-rule)]">
              {toc
                .filter((h) => h.depth === 2 || h.depth === 3)
                .map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      data-toc-slug={h.slug}
                      class:list={[
                        "toc-link block py-1 text-[12px] font-mono text-[var(--color-fg-mute)] transition-colors hover:text-[var(--color-fg)] border-l-2 border-transparent -ml-px pl-3",
                        h.depth === 3 ? "pl-5 text-[11px]" : "",
                      ]}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        </aside>
      )}
    </div>
  </div>

  <script>
    (() => {
      const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".toc-link"));
      if (tocLinks.length === 0) return;

      const headings = tocLinks
        .map((a) => {
          const slug = a.dataset.tocSlug ?? "";
          const el = document.getElementById(slug);
          return el ? { slug, el } : null;
        })
        .filter((x): x is { slug: string; el: HTMLElement } => x !== null);
      if (headings.length === 0) return;

      const setActive = (slug: string) => {
        tocLinks.forEach((a) => {
          if (a.dataset.tocSlug === slug) a.dataset.active = "true";
          else delete a.dataset.active;
        });
      };

      const TOP_OFFSET = 96;

      const update = () => {
        const scrollY = window.scrollY;
        const docHeight = document.documentElement.scrollHeight;
        const viewportH = window.innerHeight;

        if (scrollY + viewportH >= docHeight - 8) {
          setActive(headings[headings.length - 1].slug);
          return;
        }

        let active = headings[0].slug;
        for (const h of headings) {
          const top = h.el.getBoundingClientRect().top;
          if (top - TOP_OFFSET <= 0) active = h.slug;
          else break;
        }
        setActive(active);
      };

      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => { update(); ticking = false; });
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      update();
    })();
  </script>
</BaseLayout>
